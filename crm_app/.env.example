# TEMPLATE ONLY. This file is committed to GitHub, so it must never hold real values.
#
# To set up: copy this file to a new file called .env (in this same folder),
# then fill in your real values there. .env is listed in .gitignore, so git skips it.

DB_HOST=yourserver.mysql.database.azure.com
DB_PORT=3306
DB_NAME=dealer_practice
# crm_app can read dealer_practice and write only to the crm database (see sql/crm_schema.sql)
DB_USER=crm_app
DB_PASSWORD=

# Protects the app's forms. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
